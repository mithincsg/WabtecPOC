        Return the content of the given certificate
        """
        ...
    def get_certificates_from_remote_path(self, remote_path) -> object:
        """
        Retrieve all .pem certificates from a remote directory.
        :param remote_path: Path on remote host
        :return: dict {filename: x509 certificate}
        """
        ...
    def get_fingerprint_of_certificate_from_msg(self, msg_id, cert_name) -> str:
        """
            This function get the fingerprint of the certificate in the given message
            141 msg fingerprint will be process from the physical certificates available in the certs folder
            143 msg fingerprint will be obtained from the 143 message directly
            params :
                - msg id 141 or 143
                - cert_name : Any certs from certs folder
            :return : str
            :rtype : str
        """
        ...
    def has_non_root_certificates(self, params) -> bool:
        """
        Check whether the certificate store contains certificates
        other than root_ca.cert.pem and root_ca_up.cert.pem.
        :params: dict
            certs
        :return: True if non-root certificates exist
        :rtype: bool
        """
        ...
    def is_certificate_status_active_10211(self, params: Dict) -> bool:
        """
               This function check for the given certificate status from the 10211 variable by decoding the
               variable against the Appendix A given in ITO Usecase document
               params : dict
                    keys: cert_name , status, expected_result
              - 'cert_name' (str): "SMS Gateway", "Asset (Client Certificate)", "Owning RR Root CA",
               "Owning RR Intermediate CA", "Revocation Responder Service",
               "Foreign RR Root CA", "Foreign RR Intermediate CA", "Bootstrapping Bundle"
              -'status' (str) : Active or Staged
              - Optional 'expected_result' (bool or str): if provided, the function
                returns whether the actual active-status matches this expected boolean.
               :type data: str
               :return: str
               :rtype: bool
        """
        ...
    def load_x509_certificates(self) -> object:
        """
        Loads all .pem certificate files from the given directory and returns
        a dictionary mapping <filename without extensions> -> <file content>.
        """
        ...
    def verify_10211_certificate_format_and_content(self, params: Optional[Dict[Any]] = None) -> bool:
        """
        This function checks the format and certificate content in 10211
        against Appendix A of the ITO Use Case document.

        Prints certificate type level errors
        params:
            expected_result [Optional] true or false. To mark this validation as Step_Pass or Step_NTS
        Returns:
            True  -> all certificates valid
            False -> one or more certificates invalid
        """
        ...
    def verify_chain_of_trust_for_staged_certificates(self, params: Optional[Dict[Any]] = None) -> bool:
        """
        This function will perform the chain of trust for the staged certificates with other certificates in the
        certificate store . ie /disk/data/security/UP/staged certificate with /disk/data/security/UP/ certificates
        :param : dict (optional)
                leaf_cert: staged certificate file name in .pem
        :return: True if all chains are valid, else False
        :rtype:bool
        """
        ...
    def verify_chain_of_trust_in_certificate_store(self, params: Optional[Dict[Any]] = None) -> bool:
        """
            This function verify the chain of trust for leaf certificate or given certificate file.
            :params: dict (optional)
                leaf_cert
                expected_result
            :return: True if chain of trust is valid, else False
            :rtype: bool
        """
        ...
    def verify_leaf_chain(self, params: Dict) -> bool:
        """
        Verify the chain of trust for a specified leaf certificate from the active certificate store.
        :params: dict
            leaf_cert : Anyone of ito.cert.pem,rrs.cert.pem,ksm.cert.pem certificates
            expected_result : True or False
        :return: True if chain of trust is valid, else False
        :rtype: bool
        """
        ...
    def verify_signature(self, params: Dict) -> bool:
        """
            This function verify the signature of the given issuer certificate with public key in the child certificate
            :params: dict
                child_name
                issuer_name
                child
                issuer
            :return: True if signature is valid, else False
            :rtype: bool
        """
        ...
    def verify_staged_chain(self, params: Dict) -> bool:
        """
            This function verifies the chain of trust for a single staged certificate
            using issuer certificates available in the active certificate store.
            :params: dict
                cert_name : Name of the staged certificate file
                leaf_cert : x509 object of the staged certificate
                issuer_certs : dict of active certificates {name: x509 object}
            :return: True if the certificate chain is valid, False otherwise
            :rtype: bool
        """
        ...

