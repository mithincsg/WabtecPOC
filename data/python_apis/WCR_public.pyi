class PublicWayside:
    def set_comm_state(self, params: Dict) -> None:
        """
        This function sets wayside commutation state.

        Applies to a WIU / CP (Wayside Interface Unit) communication link. The
        user-facing values accepted by params['comm'] are the KEYS of the
        "comm_state" dictionary in WaysideLibConstant.py: "disable" (take the WIU
        out of comm) and "enable" (put the WIU in comm), lowercase. The wrapper
        converts the chosen key into the internal token (for example "enable" ->
        "csIN_COMM") before sending it through ScriptEngine.exe; provide the key,
        not the internal "cs*" value.

        Example:
            set_comm_state({'comm': 'enable', 'sub_id': '8101', 'cp_id': '17'})

        :param params: {<br>'comm': &lt;Input string from any available key in dictionary "comm_state" in,<br>
                    "Automation Test Suite\Onboard\Library_py\Sim_Interface\Wayside\WaysideLibConstant.py"&gt;,<br>
                    'sub_id': &lt;Value of subdivision id&gt;,<br>
                    'cp_id': &lt;Value of WIU/CP ID as given in track file&gt;}
        :type params: dict
        :return: None
        :rtype: None
        """
        ...
    def set_signal(self, params: Dict) -> None:
        """
        This function sets wayside signal state.

        Applies to a Wayside SIGNAL device. Unlike set_switch/set_comm_state, the
        accepted params['position'] values are NOT taken from a constant
        dictionary: they come from the track file's DeviceStatusFeature
        descriptions for that signal (for example "clear", "approach", "dark"),
        which the wrapper converts to the matching internal DeviceStatusCode.
        For track-circuit signals (internal SignalType "7", "8" or "9" in the
        "signal_types" dictionary in WaysideLibConstant.py) the accepted
        positions are "hazard undetected"/"track integrity verified" (-> hdNORMAL)
        and "hazard detected"/"track integrity unverified" (-> hdDETECTED). The
        special position "unknown" is also accepted. The "signal_types"
        dictionary itself is internal: its keys are SignalType codes read from
        the track file, not values a test author supplies.

        Example:
            set_signal({'position': 'clear', 'sub_id': '8101', 'name': '1001'})

        :param params: {<br>'position': &lt;list shown in "wayside device list, ASPECT" as string&gt;',<br>
                        'sub_id': &lt;Value of subdivision id as string&gt;,<br>
                        'name': &lt;Value of Wayside Devices / Device ID as given in track file as string&gt;}
        :type params: dict
        :return: None
        :rtype: None
        """
        ...
    def set_switch(self, params: Dict) -> None:
        """
        This function sets switch in the wayside sim and calls LocoLib to keep Loco sim and wayside sim in sync.

        Applies to a Wayside SWITCH device. The user-facing values accepted by
        params['position'] are the KEYS of the "device_indication" dictionary in
        WaysideLibConstant.py: "normal", "indeterminate", "reverse", "error" and
        "unknown" (lowercase; the wrapper lowercases the input). The wrapper
        converts the chosen key into the internal Wayside token (for example
        "normal" -> "swNORMAL") before sending it through ScriptEngine.exe;
        provide the key, not the internal "sw*" value. Any unrecognized position
        falls back to the "error" token. The legacy values "reversed",
        "normal-indeterminate", "reversed-indeterminate" and "default" are
        deprecated aliases (they emit a warning and are remapped).

        Example:
            set_switch({'position': 'normal', 'sub_id': '8101', 'name': '1000051'})

        :param params: {<br>'position': &lt;Input string from any available key in dictionary "device_indication" in<br>
                    "Automation Test Suite\Onboard\Library_py\Sim_Interface\Wayside\WaysideLibConstant.py"&gt;,<br>
                    'sub_id': &lt;Value of subdivision id  as string&gt;,<br>
                    'name': &lt;Value of Wayside Device ID as given in track file as string&gt;'}
        :type params: dict
        :return: None
        :rtype: None
        """
        ...

